{
  "name": "CALIBER",
  "version": "1.0.1",
  "description": "Industry design system for watch brand and boutique websites: Ink ground, Instrument Sans type, Champagne accent with Sapphire support, precise 3px radius, and web-ready product photography (space / material / object).",
  "scheme": "duo",
  "ground": "dark",
  "parameters": {
    "scheme": "duo",
    "hue": 42,
    "saturation": 0.55,
    "density": 0.94,
    "base_space_px": 4,
    "radius_px": 3,
    "rule_px": 1
  },
  "fonts": {
    "heading": "Instrument Sans",
    "body": "Instrument Sans",
    "heading_weight": 600,
    "body_weight": 400,
    "google_fonts_url": "https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&display=swap"
  },
  "colors": {
    "roles": {
      "bg": "#0A0B0D",
      "surface": "#14161A",
      "text": "#EDE8DF",
      "accent": "#C4A35A",
      "divider": "#24282E",
      "muted": "#8E9499",
      "accent_text": "#D4B872",
      "secondary": "#8E9499",
      "tertiary": "#1E3A5F",
      "names": {
        "bg": "Ink",
        "surface": "Surface",
        "text": "Bone",
        "accent": "Champagne",
        "secondary": "Steel",
        "tertiary": "Sapphire",
        "accent_text": "Champagne Light"
      }
    },
    "accent": {
      "100": "#F6EFD9",
      "200": "#EBD9A8",
      "300": "#D9C07A",
      "400": "#CDB066",
      "500": "#C4A35A",
      "600": "#A38648",
      "700": "#7E6637",
      "800": "#594826",
      "900": "#352B16"
    },
    "neutral": {
      "100": "#EDE8DF",
      "200": "#C8C3BA",
      "300": "#8E9499",
      "400": "#6A7076",
      "500": "#4A5056",
      "600": "#24282E",
      "700": "#14161A",
      "800": "#0F1114",
      "900": "#0A0B0D"
    },
    "semantic": {
      "success": "#6F8F72",
      "warning": "#C4A35A",
      "error": "#B84A4A",
      "info": "#1E3A5F"
    }
  },
  "typography": {
    "h1": {
      "size": "56px",
      "lineHeight": "1.0",
      "weight": 700,
      "letterSpacing": "-0.03em"
    },
    "h2": {
      "size": "36px",
      "lineHeight": "1.05",
      "weight": 600,
      "letterSpacing": "-0.02em"
    },
    "h3": {
      "size": "24px",
      "lineHeight": "1.12",
      "weight": 600,
      "letterSpacing": "-0.015em"
    },
    "h4": {
      "size": "20px",
      "lineHeight": "1.2",
      "weight": 500,
      "letterSpacing": "-0.01em"
    },
    "h5": {
      "size": "16px",
      "lineHeight": "1.3",
      "weight": 500,
      "letterSpacing": "0"
    },
    "h6": {
      "size": "11px",
      "lineHeight": "1.35",
      "weight": 600,
      "letterSpacing": "0.14em",
      "transform": "uppercase"
    },
    "p1": {
      "size": "16px",
      "lineHeight": "1.55",
      "weight": 400
    },
    "p2": {
      "size": "14px",
      "lineHeight": "1.55",
      "weight": 400
    },
    "p3": {
      "size": "12px",
      "lineHeight": "1.45",
      "weight": 400
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px"
  },
  "shadows": {
    "1": "0 1px 0 rgba(0,0,0,0.55)",
    "2": "0 12px 32px rgba(0,0,0,0.5)",
    "3": "0 24px 64px rgba(0,0,0,0.6)"
  },
  "radius": "3px",
  "templates": [
    "landing",
    "deck"
  ],
  "components": [
    "buttons",
    "tags",
    "badges",
    "cards",
    "forms",
    "navigation",
    "feedback",
    "table",
    "dialog",
    "patterns"
  ],
  "industry": "Watches",
  "site_jobs": [
    "Watch brand and boutique marketing sites",
    "Model and product detail pages",
    "Collection catalogs and lookbooks",
    "Retail and pitch presentation decks"
  ],
  "imagery_roles": {
    "space": "Homepage or campaign hero \u2014 dress watch on marble or boutique display with room for headline overlays",
    "material": "Craft / trust section \u2014 brushed steel, case finishing, strap grain",
    "object": "Feature or PDP card \u2014 dial, crown, hands, or movement detail"
  }
}

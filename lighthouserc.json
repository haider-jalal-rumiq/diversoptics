{
  "ci": {
    "collect": {
      "startServerCommand": "node apps/web/node_modules/next/dist/bin/next start apps/web --hostname 127.0.0.1",
      "startServerReadyPattern": "Ready in|started server",
      "url": [
        "http://127.0.0.1:3000/",
        "http://127.0.0.1:3000/eyewear",
        "http://127.0.0.1:3000/products/demo-frame-01"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "skipAudits": ["is-crawlable"]
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.85 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}

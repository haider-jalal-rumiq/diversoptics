# Public Supabase configuration is required for CMS Auth and request-bound data access.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only. Required only by the owner-driven staff invitation action.
# Never prefix this value with NEXT_PUBLIC_ and never commit the real key.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Public catalog source. Leave unset to prefer the connected project and fall back
# to fictional fixtures outside production. "fixtures" pins fixtures while the
# project is still empty. Ignored in production, which never serves fixtures.
CATALOG_SOURCE=

# Phase 05 launch gate. Crawling and indexing stay disabled unless this is
# "true" *and* the deployment is production, so a preview can never be indexed.
NEXT_PUBLIC_ENABLE_INDEXING=false

# Vercel sets this automatically. Use "production" only for the real public destination.
VERCEL_ENV=development
